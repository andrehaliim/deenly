<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_vertical"
    android:background="@drawable/widget_card_background_primary"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="-12dp"
            android:layout_marginTop="-12dp"
            android:layout_marginEnd="-8dp"
            android:layout_marginBottom="-12dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_launcher_foreground" />

        <!-- Drawn as a bitmap: launchers ignore @font in RemoteViews. -->
        <ImageView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/widget_title" />

        <!-- Shown in the widget picker preview, which can't run renderTitle. -->
        <TextView
            android:id="@+id/widget_title_fallback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="@string/widget_title"
            android:textColor="@color/widgetOnPrimary"
            android:textSize="22sp"
            android:textStyle="bold|italic" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/location_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/location_chip_background_primary"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:id="@+id/location_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_location_outlined"
                    android:tint="@color/widgetAccent" />

                <TextView
                    android:id="@+id/location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="@string/location_default"
                    android:textColor="@color/widgetOnPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="-3dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/fajr_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/prayer_tile_background_primary"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="5dp">

            <ImageView
                android:id="@+id/fajr_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginBottom="1dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_prayer_fajr"
                android:tint="@color/widgetPrimaryOnSurfaceVariant" />

            <TextView
                android:id="@+id/fajr_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/fajr_name"
                android:textColor="@color/widgetPrimaryOnSurfaceVariant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/fajr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/preview_fajr_time"
                android:textColor="@color/widgetOnPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fajr_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/lightOutline"
                android:textSize="10sp"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/dhuhr_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/prayer_tile_background_primary"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="5dp">

            <ImageView
                android:id="@+id/dhuhr_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginBottom="1dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_prayer_dhuhr"
                android:tint="@color/widgetPrimaryOnSurfaceVariant" />

            <TextView
                android:id="@+id/dhuhr_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/dhuhr_name"
                android:textColor="@color/widgetPrimaryOnSurfaceVariant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/dhuhr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/preview_dhuhr_time"
                android:textColor="@color/widgetOnPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dhuhr_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/lightOutline"
                android:textSize="10sp"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/asr_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/prayer_tile_background_primary"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="5dp">

            <ImageView
                android:id="@+id/asr_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginBottom="1dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_prayer_asr"
                android:tint="@color/widgetPrimaryOnSurfaceVariant" />

            <TextView
                android:id="@+id/asr_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/asr_name"
                android:textColor="@color/widgetPrimaryOnSurfaceVariant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/asr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/preview_asr_time"
                android:textColor="@color/widgetOnPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/asr_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/lightOutline"
                android:textSize="10sp"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/maghrib_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/prayer_tile_active_background_primary"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="5dp">

            <ImageView
                android:id="@+id/maghrib_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginBottom="1dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_prayer_maghrib"
                android:tint="@color/lightPrimary" />

            <TextView
                android:id="@+id/maghrib_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/maghrib_name"
                android:textColor="@color/lightOnSurfaceVariant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/maghrib_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/preview_maghrib_time"
                android:textColor="@color/lightPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/maghrib_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/lightOutline"
                android:textSize="10sp"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/isha_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/prayer_tile_background_primary"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="5dp">

            <ImageView
                android:id="@+id/isha_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginBottom="1dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_prayer_isha"
                android:tint="@color/widgetPrimaryOnSurfaceVariant" />

            <TextView
                android:id="@+id/isha_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/isha_name"
                android:textColor="@color/widgetPrimaryOnSurfaceVariant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/isha_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/preview_isha_time"
                android:textColor="@color/widgetOnPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/isha_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/lightOutline"
                android:textSize="10sp"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/next_prayer_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/next_prayer_background_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp">

        <ImageView
            android:id="@+id/next_prayer_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_clock"
            android:tint="@color/widgetAccent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/next_prayer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/next_prayer_text"
                android:textColor="@color/widgetPrimaryOnSurfaceVariant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/next_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:maxLines="1"
                android:text="@string/maghrib_name"
                android:textColor="@color/widgetOnPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/next_prayer_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="@string/preview_countdown"
                android:textColor="@color/widgetAccent"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/remaining_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/remaining_text"
                android:textColor="@color/widgetPrimaryOnSurfaceVariant"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
